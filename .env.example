VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# LiveKit — required for live audio in Mehfil rooms
# Get these from https://cloud.livekit.io (free tier available)
# The URL looks like: wss://your-project-xxxxx.livekit.cloud
VITE_LIVEKIT_URL=

# These two are set in Supabase Dashboard → Project Settings → Edge Functions → Secrets
# (NOT in .env.local — they are server-side only)
# LIVEKIT_API_KEY=APIxxxxxxxxxxxxxxx
# LIVEKIT_API_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
